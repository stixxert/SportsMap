{
  "name": "sports-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "moduleDirectories": [
    "node_modules",
    "src"
  ],
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "generate:api": "openapi-generator-cli generate -i https://developers.strava.com/swagger/swagger.json --skip-validate-spec -g typescript-fetch -o src/generated/strava-api",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@babel/preset-react": "^7.28.5",
