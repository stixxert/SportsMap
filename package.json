    "haversine-distance": "^1.2.4",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "leaflet-geojson-vt": "^1.1.0",
    "leaflet.vectorgrid": "^1.3.0",
    "lineclip": "^2.0.0",
    "material-react-table": "^3.2.1",
    "mitt": "^3.0.1",
    "next": "16.1.5",
    "next-themes": "^0.4.6",
    "rbush": "^4.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "reflect-metadata": "^0.2.2",
