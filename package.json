    "@testing-library/react": "^16.3.1",
    "@types/geojson-vt": "^3.2.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-jest": "^30.2.0",
